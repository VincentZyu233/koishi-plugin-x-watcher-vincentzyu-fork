{
  "name": "koishi-plugin-x-watcher",
  "description": "基于 Effect 的可靠 Twitter/X 用户动态订阅插件",
  "version": "0.2.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tsuikyuu/koishi-plugin-x-watcher.git"
  },
  "contributors": [
    "Tsuikyuu <bokusummer233@gmail.com>"
  ],
  "keywords": [
    "chatbot",
    "koishi",
    "plugin"
  ],
  "peerDependencies": {
    "@koishijs/plugin-http": "^0.6.3",
    "@koishijs/plugin-server": "^3.2.7",
    "koishi": "^4.18.7"
  },
  "peerDependenciesMeta": {
    "@koishijs/plugin-http": {
      "optional": true
    },
    "@koishijs/plugin-server": {
      "optional": true
    }
  },
  "dependencies": {
    "effect": "^3.22.0",
    "re2js": "^2.8.6",
    "rettiwt-api": "7.1.2"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@koishijs/plugin-database-sqlite": "^4.7.0",
    "@koishijs/plugin-http": "^0.6.3",
    "@koishijs/plugin-server": "^3.2.7",
    "@types/node": "^22.19.7",
    "esbuild": "^0.23.1",
    "typescript": "^5.9.3",
    "yml-register": "^1.2.5",
    "vitest": "3.2.7"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:types": "tsc -p tsconfig.json",
    "build:js": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --packages=external --outfile=lib/index.js",
    "build": "npm run clean && npm run build:types && npm run build:js",
    "prepack": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "koishi": {
    "service": {
      "required": [
        "database"
      ],
      "optional": [
        "http",
        "server"
      ]
    }
  }
}
